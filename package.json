{
  "name": "@ankhorage/game",
  "version": "0.1.2",
  "type": "module",
  "description": "Platform-neutral config-driven game semantics and runtime primitives for Ankhorage apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/game.git"
  },
  "homepage": "https://github.com/ankhorage/game#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/game/issues"
  },
  "keywords": [
    "ankhorage",
    "config-driven",
    "game",
    "game-runtime",
    "gameplay",
    "mini-games",
    "runtime",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js"
    },
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "ankh": {
    "category": "game",
    "provider": null,
    "capabilities": []
  },
  "ankhorage": {
    "renovateSyncProtocol": 1
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "bun run check-types",
    "test": "bun test src",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "prepack": "bun run build",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "version-packages": "ankhorage-changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.20.0",
    "@ankhorage/paradox": "^0.2.1",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.5.1",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
